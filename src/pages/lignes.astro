---
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import penguinsData from '../data/penguins.json';

const lineData = penguinsData
  .filter((p: any) => p.body_mass_g !== "NaN")
  .slice(0, 20)
  .map((p: any, index: number) => ({
    index: index + 1,
    body_mass_g: Number(p.body_mass_g)
  }));

const options = {
  grid: true,
  marginTop: 20,
  marginRight: 20,
  marginBottom: 30,
  marginLeft: 60,
  x: {
    label: "Indice du pingouin"
  },
  y: {
    label: "Masse corporelle (g)"
  },
  marks: [
    Plot.lineY(lineData, { x: "index", y: "body_mass_g", stroke: "blue" }),
    Plot.dot(lineData, { x: "index", y: "body_mass_g", fill: "black" }),
    Plot.ruleY([0]),
    Plot.frame()
  ]
};
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Lignes - Pingouins</title>
  </head>
  <body class="max-w-4xl mx-auto p-8 font-sans text-slate-800 bg-slate-50">
    <nav class="flex items-center gap-4 mb-8 pb-4 border-b-2 border-slate-200 text-lg">
      <a href="/" class="text-blue-600 hover:text-blue-800 font-medium transition-colors">
        Points
      </a> 
      <span class="text-slate-300">|</span> 
      <a href="/barres" class="text-blue-600 hover:text-blue-800 font-medium transition-colors">
        Barres
      </a> 
      <span class="text-slate-300">|</span> 
      <strong class="text-slate-900 bg-slate-200 px-3 py-1 rounded-md shadow-sm">
        Lignes
      </strong>
    </nav>

    <h1 class="text-3xl font-extrabold text-slate-900 mb-2">
      Graphique de Lignes : Masse Corporelle 🐧
    </h1>
    <p class="text-slate-600 mb-6">Évolution de la masse (en grammes) sur un échantillon des 20 premiers individus.</p>
    
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 overflow-x-auto">
      <PlotFigure options={options} />
    </div>
  </body>
</html>