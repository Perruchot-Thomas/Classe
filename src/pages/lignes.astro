---

import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import penguinsData from '../data/penguins.json';


const lineData = penguinsData
  .filter((p: any) => p.body_mass_g !== "NaN")
  .slice(0, 20)
  .map((p: any, index: number) => ({
    index: index + 1,
    body_mass_g: Number(p.body_mass_g)
  }));

const options = {
  grid: true,
  marginTop: 20,
  marginRight: 20,
  marginBottom: 30,
  marginLeft: 60,
  x: {
    label: "Indice du pingouin"
  },
  y: {
    label: "Masse corporelle (g)"
  },
  marks: [
    Plot.lineY(lineData, { x: "index", y: "body_mass_g", stroke: "blue" }),
    Plot.dot(lineData, { x: "index", y: "body_mass_g", fill: "black" }),
    Plot.ruleY([0]),
    Plot.frame()
  ]
};
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Lignes - Pingouins</title>
  </head>
  <body style="max-width: 800px; margin: 0 auto; font-family: sans-serif; padding: 2rem;">
    <h1>Graphique de Lignes : Évolution de la Masse des Pingouins 📈🐧</h1>
    
    <PlotFigure options={options} />
  </body>
</html>