---
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import penguinsData from '../data/penguins.json';

const options = {
  grid: true,
  marginTop: 20,
  marginRight: 20,
  marginBottom: 30,
  marginLeft: 50,
  x: {
    label: "Espèce"
  },
  y: {
    label: "Nombre de pingouins"
  },
  marks: [
    Plot.barY(penguinsData, Plot.groupX({ y: "count" }, { x: "species", fill: "species" })),
    Plot.ruleY([0]),
    Plot.frame()
  ]
};
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Barres - Pingouins</title>
  </head>
  <body style="max-width: 800px; margin: 0 auto; font-family: sans-serif; padding: 2rem;">
    <h1>Graphique de Barres : Nombre de Pingouins par Espèce 📊🐧</h1>
    
    <PlotFigure options={options} />
  </body>
</html>