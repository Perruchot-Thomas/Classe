---
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import penguinsData from '../data/penguins.json';

const options = {
  grid: true,
  marginTop: 20,
  marginRight: 20,
  marginBottom: 30,
  marginLeft: 50,
  x: {
    label: "Espèce"
  },
  y: {
    label: "Nombre de pingouins"
  },
  marks: [
    Plot.barY(penguinsData, Plot.groupX({ y: "count" }, { x: "species", fill: "species" })),
    Plot.ruleY([0]),
    Plot.frame()
  ]
};
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Barres - Pingouins</title>
  </head>
  <body class="max-w-4xl mx-auto p-8 font-sans text-slate-800 bg-slate-50">
    <nav class="flex items-center gap-4 mb-8 pb-4 border-b-2 border-slate-200 text-lg">
      <a href="/" class="text-blue-600 hover:text-blue-800 font-medium transition-colors">
        Points
      </a> 
      <span class="text-slate-300">|</span> 
      <strong class="text-slate-900 bg-slate-200 px-3 py-1 rounded-md shadow-sm">
        Barres
      </strong> 
      <span class="text-slate-300">|</span> 
      <a href="/lignes" class="text-blue-600 hover:text-blue-800 font-medium transition-colors">
        Lignes
      </a>
    </nav>

    <h1 class="text-3xl font-extrabold text-slate-900 mb-6">
      Graphique de Barres : Nombre de Pingouins par Espèce 📊🐧
    </h1>
    
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 overflow-x-auto">
      <PlotFigure options={options} />
    </div>
  </body>
</html>