---
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import penguinsData from '../data/penguins.json';

const cleanPenguins = penguinsData
  .filter((p: any) => p.culmen_length_mm !== "NaN" && p.culmen_depth_mm !== "NaN")
  .map((p: any) => ({
    species: p.species,
    culmen_length_mm: Number(p.culmen_length_mm),
    culmen_depth_mm: Number(p.culmen_depth_mm)
  }));


const options = {
  grid: true,
  inset: 10,
  color: { legend: true },
  marks: [
    Plot.frame(),
    Plot.dot(cleanPenguins, { 
      x: "culmen_length_mm", 
      y: "culmen_depth_mm", 
      stroke: "species"
    })
  ]
};
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>TP Astro - Pingouins</title>
  </head>
  <body style="max-width: 800px; margin: 0 auto; font-family: sans-serif; padding: 2rem;">
    <nav style="margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 2px solid #eee;">
      <strong>[ Points ]</strong> | 
      <a href="/barres" style="text-decoration: none; color: #0070f3;">Barres</a> | 
      <a href="/lignes" style="text-decoration: none; color: #0070f3;">Lignes</a>
    </nav>
    <h1>Les Pingouins de Palmer 🐧</h1>
    <PlotFigure options={options} />
    
  </body>
</html>