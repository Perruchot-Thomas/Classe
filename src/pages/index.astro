---
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from "@observablehq/plot";
import penguinsData from '../data/penguins.json';

const cleanPenguins = penguinsData
  .filter((p: any) => p.culmen_length_mm !== "NaN" && p.culmen_depth_mm !== "NaN")
  .map((p: any) => ({
    species: p.species,
    culmen_length_mm: Number(p.culmen_length_mm),
    culmen_depth_mm: Number(p.culmen_depth_mm)
  }));

const options = {
  grid: true,
  inset: 10,
  color: { legend: true },
  marks: [
    Plot.frame(),
    Plot.dot(cleanPenguins, { 
      x: "culmen_length_mm", 
      y: "culmen_depth_mm", 
      stroke: "species"
    })
  ]
};
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>TP Astro - Pingouins</title>
  </head>
  <body class="max-w-4xl mx-auto p-8 font-sans text-slate-800 bg-slate-50">
    
    <nav class="flex items-center gap-4 mb-8 pb-4 border-b-2 border-slate-200 text-lg">
      <strong class="text-slate-900 bg-slate-200 px-3 py-1 rounded-md shadow-sm">
        Points
      </strong> 
      <span class="text-slate-300">|</span> 
      <a href="/barres" class="text-blue-600 hover:text-blue-800 font-medium transition-colors">
        Barres
      </a> 
      <span class="text-slate-300">|</span> 
      <a href="/lignes" class="text-blue-600 hover:text-blue-800 font-medium transition-colors">
        Lignes
      </a>
    </nav>

    <h1 class="text-3xl font-extrabold text-slate-900 mb-6">
      Les Pingouins de Palmer 🐧
    </h1>
    
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 overflow-x-auto">
      <PlotFigure options={options} />
    </div>
    
  </body>
</html>